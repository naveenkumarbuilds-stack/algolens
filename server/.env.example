NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=file:./dev.db
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=0
# Local development leaves this blank. Production: same 48+ character secret as Vercel.
PROXY_SECRET=
# PostgreSQL migrations use the unpooled connection; unused by SQLite.
DIRECT_URL=
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
