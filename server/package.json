{
  "name": "@algolens/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@prisma/client": "7.10.1",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "vitest": "4.1.12"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "setup:env": "node scripts/setup-env.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "node scripts/test.js",
    "lint": "eslint .",
    "db:generate:postgres": "prisma generate --schema prisma-postgres/schema.prisma",
    "db:deploy:postgres": "prisma migrate deploy --schema prisma-postgres/schema.prisma"
  }
}
