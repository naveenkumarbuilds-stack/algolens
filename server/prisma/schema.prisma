generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  timeZone     String         @default("Asia/Kolkata")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  problems     SavedProblem[]
  practiceLogs PracticeLog[]
}

model SavedProblem {
  id          String        @id @default(cuid())
  userId      String
  title       String
  mode        String        @default("library")
  algorithmId String?
  sourceCode  String?
  language    String?
  visualVariable String @default("")
  inputJson   String
  tagsJson    String        @default("[]")
  notes       String        @default("")
  status      String        @default("revisit")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceLogs PracticeLog[]

  @@index([userId, updatedAt])
  @@index([userId, status])
}

model PracticeLog {
  id             String        @id @default(cuid())
  userId         String
  savedProblemId String?
  eventId        String
  algorithmId    String?
  practiceDate   String
  timeZone       String
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedProblem   SavedProblem? @relation(fields: [savedProblemId], references: [id], onDelete: SetNull)

  @@unique([userId, eventId])
  @@index([userId, practiceDate])
}
